// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  passwordHash      String
  isAdmin           Boolean       @default(false)
  mustChangePassword Boolean      @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  composeFiles      ComposeFile[]
}

model DockerHost {
  id             String        @id @default(cuid())
  name           String
  connectionType String        // "API" or "SSH"
  host           String
  port           Int
  credentials    String        // Encrypted credentials JSON
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  deployments    Deployment[]
  metrics        HostMetrics[]
}

model ComposeFile {
  id           String        @id @default(cuid())
  name         String
  content      String        // docker-compose.yml content
  userId       String
  generatedBy  String        // "AI" or "Manual"
  createdAt    DateTime      @default(now())
  
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments  Deployment[]
}

model Deployment {
  id            String        @id @default(cuid())
  composeFileId String
  hostId        String
  status        String        // "pending", "running", "stopped", "failed"
  deployedAt    DateTime      @default(now())
  metadata      String?       // JSON metadata
  
  composeFile   ComposeFile   @relation(fields: [composeFileId], references: [id], onDelete: Cascade)
  host          DockerHost    @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model HostMetrics {
  id           String      @id @default(cuid())
  hostId       String
  cpuUsage     Float       // Percentage 0-100
  ramUsage     Float       // Percentage 0-100
  diskUsage    Float       // Percentage 0-100
  networkPorts String      // JSON array of available ports
  timestamp    DateTime    @default(now())
  
  host         DockerHost  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  
  @@index([hostId, timestamp])
}

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
